{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./static/dist",
    "rootDir": "./static/src",
    "skipLibCheck": true
  },
  "include": [
    "static/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "static/dist"
  ]
}
